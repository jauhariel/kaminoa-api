# ── Salin ke .env lalu isi seperlunya ──
# cp .env.example .env
# Semua nilai OPSIONAL kecuali API_KEY (hanya kalau ada endpoint auth: true).
# Fitur yang butuh kredensial punya fallback sendiri, jadi API tetap jalan
# walau env di bawah kosong (mode terbatas / pakai default).

# ── Inti (index.js) ──
# Master key admin: tanpa limit, dipakai untuk /admin/plan & akses darurat.
# User biasa TIDAK pakai ini — mereka punya API key pribadi masing-masing.
API_KEY=
# Port server (default 47291 bila kosong).
PORT=47291

# ── Login OAuth (Google) ──
# Kalau diisi, SEMUA halaman WAJIB login Google, dan SEMUA endpoint API
# WAJIB pakai API key pribadi user (header x-api-key) dengan kuota plan.
# Kosongkan = mode tanpa login (perilaku lama).
#
# Secret session cookie. Wajib diisi untuk production (generate: openssl rand -hex 32).
SESSION_SECRET=
#
# Google — buat di https://console.cloud.google.com/apis/credentials
#   Tipe: OAuth client ID (Web). Authorized redirect URI:
#   http://localhost:47291/auth/google/callback   (+ URL production kamu)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# ── Plan & kuota harian (request/hari) ──
# User baru otomatis dapat plan "free". Upgrade manual via:
#   curl -X POST http://localhost:47291/admin/plan \
#     -H "x-api-key: MASTER_API_KEY" -H "Content-Type: application/json" \
#     -d '{"email":"user@gmail.com","plan":"pro"}'
FREE_DAILY_LIMIT=100
PRO_DAILY_LIMIT=50000
#
# ── Pembayaran (MustikaPay) — upgrade Pro otomatis via QRIS ──
# API key dari https://mustikapayment.com (Profile Dashboard).
# Set juga Webhook URL di sana: https://domainkamu/pay/webhook
# (Tanpa webhook pun upgrade tetap jalan via auto-poll dari dashboard.)
MUSTIKA_API_KEY=
PRO_PRICE=10000
PRO_DURATION_DAYS=30
#
# Batasi akun yang boleh login (opsional, pisahkan dengan koma).
# Kalau kosong, SEMUA akun Google bisa login.
# Format: email atau google:ID.
# ALLOWED_USERS=kamu@gmail.com,teman@gmail.com
ALLOWED_USERS=
#
# Email yang jadi admin halaman /admin (pisahkan dengan koma).
# Admin bisa lihat/ubah plan semua user & membuat admin key unlimited.
# ADMIN_USERS=kamu@gmail.com
ADMIN_USERS=

# ── Sakana AI (/ai/sakana) ──
# Session token override. Kalau kosong, endpoint auto-mint session sendiri via Firebase.
SAKANA_SESSION=

# ── Qwen (lib/qwen.js) ──
# Kredensial akun Qwen. Ada default hardcoded di kode, override di sini kalau
# mau pakai akun sendiri (disarankan, biar tidak berbagi rate-limit).
QWEN_EMAIL=
QWEN_PASSWORD=
